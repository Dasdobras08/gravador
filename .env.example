# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.
# Sem OPENAI_API_KEY o app roda em MODO DEMONSTRAÇÃO (não transcreve o seu áudio).

PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Provedor: "openai" (qualquer API compatível) ou "demo". Padrão: openai se houver chave, senão demo.
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
SUMMARY_MODEL=gpt-4o-mini
TRANSCRIPTION_LANGUAGE=pt

# Para hospedar (HOST diferente de localhost), a senha é obrigatória. Usuário: qualquer; senha: esta.
# APP_PASSWORD=

# ── Modo serviço (contas, planos e saldo) ── veja docs/SUPABASE.md
# Com SUPABASE_URL definida o app exige login e guarda tudo no Supabase.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_ANON_KEY=           # chave pública (anon)
# SUPABASE_SERVICE_ROLE_KEY=   # SEGREDO: só no servidor; nunca no navegador nem no Git
# SUPABASE_AUDIO_BUCKET=audio
